# Production mode: VK polling -> LLM/Google Sheets -> Telegram SMM notification.
# No Caddy, public domain, VK Callback confirmation code or inbound HTTP ports are required.

# PostgreSQL (production database)
POSTGRES_DB=cpgames
POSTGRES_USER=cpgames
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional explicit SQLAlchemy URL. Leave empty to build it from POSTGRES_* above.
DATABASE_URL=

# VK polling
VK_GROUP_ID=-123456789
VK_ACCESS_TOKEN=replace_me
CHECK_INTERVAL=60
# Объединять соседние VK-комментарии одного автора в одном посте, если разрыв не больше N секунд. 0 = выключить.
VK_COMMENT_MERGE_WINDOW_SECONDS=180
# Загружать ответы внутри веток VK (thread). Рекомендуется true.
VK_FETCH_THREAD_REPLIES=true
# Повторять временно неудачные HTTP-запросы к VK API (таймауты/сетевые ошибки).
# По умолчанию: до 3 попыток с паузами 2 и 5 секунд между ними.
VK_API_RETRY_ATTEMPTS=3
VK_API_RETRY_BACKOFF_SECONDS=2,5
POSTS_COUNT=3
# First production run snapshots existing comments without notifying Telegram.
VK_NOTIFY_EXISTING=false

# Telegram notifications for the SMM specialist
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# LLM used to prepare a suggested SMM reply
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=replace_me
LLM_MODEL=replace_me

# Google Sheets knowledge base
GOOGLE_SHEETS_ID=replace_me
GOOGLE_SHEETS_CREDENTIALS=credentials.json
GOOGLE_SHEETS_RANGE=Шаблон для копирования!A:G

# FastAPI process. Background workers are enabled in production.
BACKGROUND_WORKERS_ENABLED=true

# Optional Telegram user parser (Telethon), disabled until real API credentials
# and an authorized session are ready.
TELEGRAM_PARSER_ENABLED=false
API_ID=123456
API_HASH=replace_me
PHONE_NUMBER=+79999999999
SESSION_NAME=/app/data/parser_session
TELEGRAM_CHANNEL=fabrica_igr
TELEGRAM_POSTS_LIMIT=3
TELEGRAM_COMMENTS_LIMIT=200
TELEGRAM_CHECK_INTERVAL=60
TELEGRAM_EXPORT_DIR=/app/data
TELEGRAM_STATE_FILE=/app/data/telegram_seen.json
TELEGRAM_NOTIFY_EXISTING=false

# Optional extra brand aliases whose own comments should be ignored.
# Comma-separated; built-in aliases already include "Фабрика игр", "cpgames", "cp games".
OWN_BRAND_NAMES=
# Optional Telegram own-account safeguards. Normally TELEGRAM_CHANNEL + detected
# channel/discussion IDs are enough. Add comma-separated values only for extra
# aliases/peers that may post on behalf of the company.
OWN_BRAND_USERNAMES=
OWN_TELEGRAM_IDS=
